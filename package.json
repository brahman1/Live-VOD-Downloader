{
  "name": "live-and-vod-downloader",
  "version": "1.2.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"cross-env BROWSER=none vite\" \"npm run dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "prebuild": "node scripts/download-bins.js",
    "build:base": "vite build",
    "build:win": "npm run build:base && electron-builder --win",
    "build:mac-x64": "npm run build:base && electron-builder --mac --x64",
    "build:mac-arm64": "npm run build:base && electron-builder --mac --arm64",
    "build:linux": "npm run build:base && electron-builder --linux",
    "build:all": "npm run build:base && electron-builder -wml"
  },
  "build": {
    "appId": "com.brahim.liveandvoddownloader",
    "productName": "Live & VOD Downloader",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*/ffmpeg-static/*",
      "**/*/ffprobe-static/*"
    ],
    "mac": {
      "icon": "build/icon.png",
      "artifactName": "Live_and_VOD_Downloader_macOS_${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "yt-dlp_macos"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "Live_and_VOD_Downloader_Setup.${ext}",
      "target": "nsis",
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "yt-dlp.exe"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "Live_and_VOD_Downloader_Linux.${ext}",
      "target": [
        "zip"
      ],
      "category": "Video",
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "yt-dlp"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Live_and_VOD_Downloader_Setup.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "brahman1",
        "repo": "DownloaderWebSite"
      }
    ]
  },
  "keywords": [],
  "author": "Brahim <brahim-arab@outlook.fr>",
  "license": "ISC",
  "description": "Live & VOD Downloader",
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^31.2.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "wait-on": "^9.0.4"
  }
}
